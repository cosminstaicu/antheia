{
	"name" : "antheia/framework",
	"description" : "Frontend and interface framework for web-based applications.",
	"type" : "library",
	"license" : "Apache-2.0",
	"autoload" : {
		"psr-4" : {
			"Antheia\\Framework\\" : "src/Framework"
		}
	},
	"archive" : {
		"exclude" : [
			"/tests",
			"/package.json",
			"/package-lock.json",
			"/playwright.config.ts"
		]
	},
	"authors" : [{
			"name" : "Cosmin Staicu",
			"email" : "cosminstaicu@gmail.com",
			"role" : "Developer"
		}
	],
	"config" : {
		"sort-packages" : true
	},
	"require" : {
		"php" : "^7.2 || ^8.0",
		"ext-gd" : "*",
		"ext-zip" : "*"
	},
	"minimum-stability" : "stable",
	"keywords" : [
		"frontend",
		"dark mode",
		"framework",
		"interface",
		"ui",
		"components"
	],
	"homepage" : "https://github.com/cosminstaicu/antheia",
	"support" : {
		"issues" : "https://github.com/cosminstaicu/antheia/issues",
		"source" : "https://github.com/cosminstaicu/antheia"
	}
}